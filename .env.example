# Run switches and policies: configuration/run.toml.
# Model IDs, routing and limits: configuration/models.toml.
# This file is for endpoint URLs and credentials, not run feature switches.

# Active pipeline model endpoint (local Ollama aliases; see configuration/test-pdf.md).
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# To separate your traces from other application
LANGSMITH_PROJECT=new-agent

# Add API keys for connecting to LLM providers, data sources, and other integrations here
BASE_URL =
API_KEY =
DEFAULT_MODEL =

# Separate NuExtract formatter endpoint; VLM extraction stays unrestricted.
FORMATTER_BASE_URL=http://localhost:8000/v1
FORMATTER_MODEL=numind/NuExtract3
FORMATTER_API_KEY=EMPTY

# Explicitly configure before creating tables or writing batches.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/parser
DB_BATCH_SIZE=50

REDIS_URL=redis://localhost:6379/0
